# Cle API Google Gemini (obligatoire)
# A creer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modele Gemini (optionnel, defaut: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Secret partage entre l'app Android et le backend (obligatoire en prod)
# Genere une longue chaine aleatoire. L'app l'envoie dans l'en-tete x-app-secret.
APP_SECRET=

# Limite de recettes gratuites par jour et par appareil
FREE_DAILY_LIMIT=3

# Limite de securite pour les abonnes Premium (anti-abus)
PREMIUM_DAILY_LIMIT=30

# Upstash Redis (pour appliquer la limite quotidienne)
# A creer via l'integration Upstash sur Vercel (offre gratuite).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Compte de service Google Play (optionnel, pour verifier le Premium plus tard)
# JSON du compte de service, sur une seule ligne.
GOOGLE_PLAY_SERVICE_ACCOUNT=
